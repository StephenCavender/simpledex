{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "outputs": ["convex/_generated/**"],
      "inputs": ["convex/**"]
    },
    "build": {
      "dependsOn": ["^build", "^codegen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "_site/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    },
    "@simpledex/backend#build": {
      "outputs": []
    }
  },
  "globalEnv": ["VITE_CONVEX_URL", "CONVEX_DEPLOY_KEY"]
}
