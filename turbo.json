{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "outputs": ["convex/_generated/**"],
      "inputs": ["convex/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "_site/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["@simpledex/web#build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    },
    "@simpledex/brand#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/mobile/assets/images/**",
        "$TURBO_ROOT$/apps/web/public/logo.svg",
        "$TURBO_ROOT$/apps/marketing/src/images/logo.svg"
      ],
      "outputs": []
    },
    "@simpledex/backend#build": {
      "outputs": []
    }
  },
  "globalEnv": ["VITE_CONVEX_URL", "EXPO_PUBLIC_CONVEX_URL", "CONVEX_DEPLOY_KEY"]
}
