{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/mobile": {
      "entry": ["src/app/**/*.tsx", "src/global.css", "test/**/*.test.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "test/**/*.tsx"]
    },
    "apps/web": {
      "entry": ["src/routes/__root.tsx", "src/routes/**/*.tsx", "src/index.css"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css"]
    },
    "packages/ui": {
      "entry": ["src/**/*.ts", "src/**/*.tsx", "src/styles/*.css"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.css"]
    },
    "packages/backend": {
      "entry": ["convex/*.ts", "scripts/*.ts"],
      "project": ["convex/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/brand": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/env": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/pokedex": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/tokens": {
      "project": ["test/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["vercel"]
}
