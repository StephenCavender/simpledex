{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["src/routes/__root.tsx", "src/routes/**/*.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/ui": {
      "entry": ["src/**/*.ts", "src/**/*.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/backend": {
      "entry": ["convex/*.ts", "scripts/*.ts"],
      "project": ["convex/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/env": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["vercel"]
}
