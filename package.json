{
  "name": "simpledex",
  "private": true,
  "workspaces": {
    "apps": [
      "apps/*"
    ],
    "packages": [
      "packages/*"
    ]
  },
  "catalog": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.13",
    "typescript": "^6",
    "next-themes": "^0.4.6",
    "convex": "^1.33.1",
    "@types/react-dom": "^19.2.3"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run dev:web & bun run dev:backend & bun run dev:marketing && wait",
    "dev:web": "cd apps/web && bun run dev",
    "dev:backend": "cd packages/backend && bun run dev",
    "dev:marketing": "cd apps/marketing && bun run dev",
    "dev:setup": "cd packages/backend && bun run dev:setup",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "cd apps/web && bun test",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@simpledex/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simpledex/config": "workspace:*",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}