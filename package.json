{
  "name": "simpledex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@simpledex/web",
    "dev:backend": "turbo run dev --filter=@simpledex/backend",
    "dev:marketing": "turbo run dev --filter=@simpledex/marketing",
    "dev:setup": "turbo run dev:setup --filter=@simpledex/backend",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "ci:check": "rm -rf node_modules .turbo && bun install --frozen-lockfile && bun run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run e2e",
    "check": "oxlint && oxfmt --write && knip",
    "knip": "knip"
  },
  "devDependencies": {
    "@simpledex/config": "workspace:*",
    "@types/node": "^25.6.0",
    "knip": "^6.11.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.10",
  "catalog": {
    "zod": "^4.1.13",
    "typescript": "^6",
    "next-themes": "^0.4.6",
    "convex": "^1.33.1",
    "@types/react-dom": "^19.2.3"
  }
}
