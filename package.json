{
  "name": "simpledex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@simpledex/web",
    "dev:backend": "turbo run dev --filter=@simpledex/backend",
    "dev:marketing": "turbo run dev --filter=@simpledex/marketing",
    "dev:setup": "turbo run dev:setup --filter=@simpledex/backend",
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "ci:check": "rm -rf node_modules .turbo && bun install --frozen-lockfile && bun run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run e2e",
    "check": "oxlint && oxfmt --write && knip",
    "knip": "knip",
     "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod"
  },
  "devDependencies": {
    "@simpledex/config": "workspace:*",
    "@types/node": "catalog:",
    "knip": "^6.42.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "zod": "^4.6.7",
    "typescript": "^7",
    "next-themes": "^0.4.6",
    "convex": "^1.47.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/node": "^22.13.14",
    "lucide-react": "^1.59.0",
    "tailwindcss": "^4.3.3"
  }
}
